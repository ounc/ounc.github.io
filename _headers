# Cloudflare Pages Custom Headers for ounc-blog
# Optimize edge caching and security headers

# Default security headers for all files
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-XSS-Protection: 1; mode=block

# HTML pages should not be cached aggressively to ensure visitors see updates immediately
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Cache static assets (CSS, JS, Fonts) aggressively for 1 year (immutable)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
